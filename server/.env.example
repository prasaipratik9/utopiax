# UtopiaX API — copy to server/.env (or repo root .env)

PORT=4000
JWT_SECRET=utopiax-dev-secret-change-me
SESSION_HOURS=24

# Dev login (also used to bootstrap first Supabase admin row)
ADMIN_USER=admin
ADMIN_PASSWORD=utopiax-admin

# Optional Supabase (when set, content + admins use the DB)
# Create a free project at https://supabase.com → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (HTTPS email API) — enquiry notifications + confirmations
RESEND_API_KEY=
MAIL_TO=

# Legacy SMTP (Nodemailer) — no longer used while Resend is active; kept for optional rollback
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional Cloudinary (signed admin uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
